{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "0.1",
  "status": "Versioned read-only evidence tool contract",
  "validation_vocabulary": [
    "$ref",
    "oneOf",
    "type",
    "properties",
    "required",
    "additionalProperties",
    "items",
    "minItems",
    "maxItems",
    "minLength",
    "maxLength",
    "pattern",
    "format (date only)",
    "minimum",
    "maximum",
    "const",
    "enum"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]{2,}$",
