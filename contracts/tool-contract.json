          ],
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "format": {
          "type": "string",
