  "tools": {
    "search_facts": {
      "description": "Retrieve bounded scoped evidence with full provenance.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "enum": [
              "rent",
              "vacancy",
              "leasing",
              "pipeline",
              "macro",
              "demand",
              "esg",
              "events"
            ],
            "pattern": "\\S"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "geography": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "\\S"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "\\S"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "response": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1"
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "facts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/fact"
                    },
                    "maxItems": 100
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "topic": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "enum": [
                          "rent",
                          "vacancy",
                          "leasing",
                          "pipeline",
                          "macro",
                          "demand",
                          "esg",
                          "events"
                        ],
                        "pattern": "\\S"
                      },
                      "metric": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "geography": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "entity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "period_start": {
                        "type": "string",
                        "format": "date",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "\\S"
                      },
                      "period_end": {
                        "type": "string",
                        "format": "date",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "\\S"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "match_semantics": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "facts",
                  "count",
                  "limit",
                  "truncated",
                  "filters",
                  "match_semantics"
                ],
                "additionalProperties": false
              },
              "error": {
                "type": "null"
              }
            },
            "required": [
              "contract_version",
              "ok",
              "data",
              "error"
            ],
            "additionalProperties": false
          },
          {
            "$ref": "#/$defs/error_envelope"
          }
        ]
      }
    },
    "get_fact": {
      "description": "Retrieve one fact with complete source metadata.",
      "parameters": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$",
            "minLength": 3,
            "maxLength": 16
          }
        },
        "required": [
          "fact_id"
        ],
        "additionalProperties": false
      },
      "response": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1"
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "$ref": "#/$defs/fact"
              },
              "error": {
                "type": "null"
              }
            },
            "required": [
              "contract_version",
              "ok",
              "data",
              "error"
            ],
            "additionalProperties": false
          },
          {
            "$ref": "#/$defs/error_envelope"
          }
        ]
      }
    },
    "compare_facts": {
      "description": "Compare compatible time observations or an explicitly approved cross-section pair.",
      "parameters": {
        "type": "object",
        "properties": {
          "fact_id_a": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$",
            "minLength": 3,
            "maxLength": 16
          },
          "fact_id_b": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$",
            "minLength": 3,
            "maxLength": 16
          },
          "mode": {
            "type": "string",
            "enum": [
              "time_series",
              "cross_section"
            ]
          }
        },
        "required": [
          "fact_id_a",
          "fact_id_b"
        ],
        "additionalProperties": false
      },
      "response": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1"
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "time_series"
                      },
                      "earlier": {
                        "$ref": "#/$defs/fact"
                      },
                      "later": {
                        "$ref": "#/$defs/fact"
                      },
                      "difference": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "difference_unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "basis_points": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "relative_change_percent": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "relative_change_approximate": {
                        "type": "boolean"
                      },
                      "rounding_caveat": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "\\S"
                      },
                      "calculation": {
                        "type": "string",
                        "const": "later_minus_earlier"
                      }
                    },
                    "required": [
                      "mode",
                      "earlier",
                      "later",
                      "difference",
                      "difference_unit",
                      "basis_points",
                      "relative_change_percent",
                      "relative_change_approximate",
                      "rounding_caveat",
                      "calculation"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "cross_section"
                      },
                      "a": {
                        "$ref": "#/$defs/fact"
                      },
                      "b": {
                        "$ref": "#/$defs/fact"
                      },
                      "difference": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "difference_unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "basis_points": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "relative_change_percent": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                        "maxLength": 80
                      },
                      "relative_change_approximate": {
                        "type": "boolean"
                      },
                      "rounding_caveat": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "\\S"
                      },
                      "calculation": {
                        "type": "string",
                        "const": "b_minus_a"
                      },
                      "comparison_group": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "mode",
                      "a",
                      "b",
                      "difference",
                      "difference_unit",
                      "basis_points",
                      "relative_change_percent",
                      "relative_change_approximate",
                      "rounding_caveat",
                      "calculation",
                      "comparison_group"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "error": {
                "type": "null"
              }
            },
            "required": [
              "contract_version",
              "ok",
              "data",
              "error"
            ],
            "additionalProperties": false
          },
          {
            "$ref": "#/$defs/error_envelope"
          }
        ]
      }
    },
