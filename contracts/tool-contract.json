          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        }
      },
      "required": [
        "source_id",
        "publisher",
        "title",
        "url",
        "published_at",
        "retrieved_at",
        "format",
        "access_status",
        "role",
        "notes"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^F[0-9]{2,}$",
          "minLength": 3,
          "maxLength": 16
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "geography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "geography_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "value_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 8000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "period_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "period_start": {
          "type": "string",
          "format": "date",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "\\S"
        },
        "period_end": {
          "type": "string",
          "format": "date",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "\\S"
        },
        "comparison_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "\\S"
        },
        "comparison_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]{2,}$",
          "minLength": 3,
          "maxLength": 16
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "paraphrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "caveat": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8000
        },
        "series_key": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8000
        },
        "source_publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "source_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "source_published_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "source_retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "value_num": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "fact_id",
        "topic",
        "metric",
        "entity",
        "geography",
        "geography_basis",
        "segment",
        "value_text",
        "unit",
        "period_kind",
        "period_start",
        "period_end",
        "comparison_start",
        "comparison_end",
        "status",
        "evidence_class",
        "source_id",
        "locator",
        "paraphrase",
        "caveat",
        "series_key",
        "source_publisher",
        "source_title",
        "source_url",
