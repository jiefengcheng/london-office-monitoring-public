        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        }
      },
      "required": [
        "requirement",
        "coverage_status",
        "sources",
        "notes"
      ],
      "additionalProperties": false
    },
    "error_envelope": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "0.1"
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENT",
                "NOT_FOUND",
                "COMPARISON_REFUSED",
                "EVIDENCE_UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "ok",
        "data",
        "error"
      ],
      "additionalProperties": false
    }
