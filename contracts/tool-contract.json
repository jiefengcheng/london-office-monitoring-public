            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1"
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "request": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  "requested_scope": {
                    "type": "object",
                    "properties": {
                      "topic": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "enum": [
                          "rent",
                          "vacancy",
                          "leasing",
                          "pipeline",
                          "macro",
                          "demand",
                          "esg",
                          "events"
                        ],
                        "pattern": "\\S"
                      },
                      "metric": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "geography": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "entity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "period_start": {
                        "type": "string",
                        "format": "date",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "\\S"
                      },
                      "period_end": {
                        "type": "string",
                        "format": "date",
                        "minLength": 10,
                        "maxLength": 10,
                        "pattern": "\\S"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "inferred_fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "maxItems": 7
                  },
                  "unresolved_fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    },
                    "maxItems": 8
                  },
                  "assessment": {
                    "type": "string",
                    "enum": [
                      "needs_scope",
                      "matching_facts_in_fixture",
                      "no_matching_facts_in_fixture"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  "coverage_rows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coverage_row"
                    },
                    "maxItems": 10
                  },
                  "available_fact_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^F[0-9]{2,}$",
                      "minLength": 3,
                      "maxLength": 16
                    },
                    "maxItems": 100
                  },
                  "available_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "scope_limit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "request",
                  "requested_scope",
                  "inferred_fields",
                  "unresolved_fields",
                  "assessment",
                  "message",
                  "coverage_rows",
                  "available_fact_ids",
                  "available_count",
                  "truncated",
                  "scope_limit"
                ],
                "additionalProperties": false
              },
              "error": {
                "type": "null"
              }
            },
            "required": [
              "contract_version",
              "ok",
              "data",
              "error"
            ],
            "additionalProperties": false
          },
          {
            "$ref": "#/$defs/error_envelope"
          }
        ]
      }
    }
  }
}
