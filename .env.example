# Copy to .env locally; .env is ignored by Git. Never commit credentials.
MODEL_PROVIDER=openai
# API is the core default; set MODEL_NAME and your own key locally.
# Optional Apple: MODEL_PROVIDER=apple after scripts/install.py --profile apple.
# Apple uses the on-device system model; no API key or MODEL_NAME is needed.
APPLE_TIMEOUT_SECONDS=90
APPLE_MAX_OUTPUT_TOKENS=1024
# Core OpenAI route: MODEL_PROVIDER=openai, then set these locally.
# Exact Responses/tool-calling/structured-output-capable model ID available to you.
MODEL_NAME=
MODEL_API_KEY=
# OPENAI_API_KEY may be used instead of MODEL_API_KEY.
# Normally leave blank to use the official OpenAI Responses endpoint. The
# client also permits HTTP only to a loopback /v1/responses simulator.
MODEL_API_ENDPOINT=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=4096
# Existing local .env values override the default: change MODEL_PROVIDER=apple
# or use --provider apple. OpenAI keys are unused by the Apple provider.
# Offline scripted verification needs no model or credentials; it is not live acceptance.
